    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "csv-parse": "6.1.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/node": "24.9.2",
    "esbuild": "0.25.11",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "playwright-core": "1.56.1"
  }
